# ============================================================================
# AI Agent Observability - Environment Variables Template
# Export variables in your shell, or copy this file to .env inside the package
# directory you are running (pass --env-file=.env to tsx if a script does not
# auto-load .env).
# Note: Offline simulators and evaluation pipelines run without API keys;
# live model examples (such as ch01-support-agent.ts) require GEMINI_API_KEY
# (or OPENAI_API_KEY for live LangChain examples).
# ============================================================================

# --- Google Gemini / Firebase Genkit (Chapters 1, 2, 3, 4, 5, 11, 13, 17, 20, 22, 23) ---
GEMINI_API_KEY=your-gemini-api-key-here
GCLOUD_PROJECT=your-gcp-project-id
ENABLE_FIREBASE_MONITORING=false

# --- OpenAI / LangChain v1 (Chapters 6, 7, 8, 11-16, 18, 20) ---
OPENAI_API_KEY=your-openai-api-key-here

# --- LangSmith Tracing & Evaluation (Chapters 7, 11-16, 18, 20) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGSMITH_PROJECT=ai-agent-observability-prod
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- OpenTelemetry GenAI Semantic Conventions (Chapters 9, 10, 19, 20) ---
OTEL_SERVICE_NAME=support-agent-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
OTEL_GENAI_CAPTURE_CONTENT=false

# --- Progress Observability Platform (Chapters 10, 19) ---
PROGRESS_OBSERVABILITY_COLLECTOR_URL=https://otel.observability.progress.com/v1/traces
PROGRESS_OBSERVABILITY_API_KEY=pop_live_your_api_key_here
